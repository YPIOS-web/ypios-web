# URL publique canonique, sans slash final
NEXT_PUBLIC_SITE_URL=https://ypios.fr

# Mesure d'audience facultative (chargée uniquement après consentement)
NEXT_PUBLIC_GA_ID=

# Protection facultative du formulaire (configurer les deux clés ensemble)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Envoi du formulaire de contact
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=contact@ypios.fr
CONTACT_CC=
